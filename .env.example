# Copy to .env.local for local development.
NEXT_PUBLIC_APP_NAME="Jira Analytics Dashboard"
JIRA_DOMAIN="https://your-domain.atlassian.net"
JIRA_EMAIL="you@example.com"
JIRA_API_TOKEN="your-api-token"
# Optional: if using OAuth 2.0 or bearer token instead of API token.
JIRA_OAUTH_TOKEN=""
JIRA_PROJECT_KEY=""
JIRA_BOARD_ID=""
JIRA_STORY_POINTS_FIELD="customfield_10016"
JIRA_SPRINT_FIELD="customfield_10020"
# Optional overrides if Jira names differ. Leave blank to match License/BU, Audit Type, Application, and Epic Link by name.
JIRA_LICENSE_BU_FIELD=""
JIRA_AUDIT_TYPE_FIELD=""
JIRA_APPLICATION_FIELD=""
JIRA_EPIC_LINK_FIELD=""
JIRA_LOOKBACK_DAYS="120"
JIRA_MAX_ISSUES="1000"
JIRA_PAGE_SIZE="100"
# Optional. Leave empty so dashboards ignore HTTP_PROXY/HTTPS_PROXY (SMTP tinyproxy must not be used for Jira).
# JIRA_HTTP_PROXY=""
CACHE_TTL_MS="60000"
JIRA_CACHE_TTL_MS="60000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
BACKEND_API_URL="http://localhost:5001/api/v1"
CORS_ORIGIN="http://localhost:3000"

# Protect dashboard + sync. Required for sync in production. Jira webhooks can send the same value as ?token=
BACKEND_API_TOKEN=""
SYNC_API_TOKEN=""
SYNC_INTERVAL_MS="900000"
STALE_AFTER_MS="1800000"

DB_ENABLED="false"
DB_AUTO_CREATE="false"
DB_HOST="percona-proxy"
DB_PORT="3306"
DB_NAME="jira_analytics"
DB_USER="jira_dashboard"
DB_PASSWORD=""
DB_SSL="true"
DB_SSL_VERIFY="true"
DB_CONNECTION_LIMIT="10"

# Monthly SRE Audit email report (SMTP)
SMTP_HOST=""
SMTP_PORT="25"
SMTP_SECURE="false"
# Set true if your working curl uses --ssl-reqd
SMTP_REQUIRE_TLS="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"
# Host-side tinyproxy (compose maps hostname tinyproxy → host-gateway)
# Use SMTP_PROXY only — do NOT set HTTP_PROXY/HTTPS_PROXY to tinyproxy or Jira dashboards will time out.
SMTP_PROXY="http://tinyproxy:8888"
MONTHLY_REPORT_TO="you@example.com"
MONTHLY_REPORT_PROJECT_KEY=""
MONTHLY_REPORT_DASHBOARD_URL="http://localhost:3000"
MONTHLY_REPORT_ENABLED="true"
MONTHLY_REPORT_DAY="1"
# Required for HTTP POST /api/v1/reports/monthly when NODE_ENV=production
SYNC_API_TOKEN="change-me"
